# Supabase クラウドプロジェクトの設定値
# ダッシュボード > Project Settings > API から取得して .env.local にコピーする

# プロジェクト URL（ブラウザにも公開される）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon public キー（RLS 前提でフロントの読み取りに使う・公開される）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role キー（サーバー専用・RLS をバイパスする）
# cron スクリプトと Server Actions の書き込みに使う。絶対にクライアントへ出さないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API キー（サーバー専用・NEXT_PUBLIC_ は付けない）
# Phase2 の AI 要約（Claude Haiku）で使用。未設定なら要約はスキップ（ingest は成功）
ANTHROPIC_API_KEY=your-anthropic-api-key
VOYAGE_API_KEY=